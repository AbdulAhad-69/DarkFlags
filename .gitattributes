# Enforce deterministic LF line endings across all platforms
# Prevents Windows CRLF checkout conversions from invalidating CSP SHA-256 hashes

* text=auto eol=lf
*.html text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.txt text eol=lf
_headers text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
